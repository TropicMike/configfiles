{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "deepseek41-flash",

  // Default model for every project. Implementation, refactoring, test/build fixes.
  "model": "opencode-go/deepseek-v4.1-flash",

  // Solved-problem notes from past sessions, in the Obsidian vault.
  // Loaded into every session so faults already diagnosed aren't re-diagnosed.
  // The path is a placeholder: deploy.sh and deploy.bat substitute this
  // machine's vault location at install time. Set OBSIDIAN_VAULT to point at a
  // vault outside the default location.
  "instructions": [
    "__AI_MEMORY_GLOB__"
  ],

  "agents": {
    // ---------------------------------------------------------------------
    // Zero-quota background maintenance.
    // V2 replaced the deprecated `small_model` with the hidden `title` agent,
    // and its siblings `summary` and `compaction` cover the rest of the
    // lightweight work. All three run on the free model so they cost nothing.
    // ---------------------------------------------------------------------
    "title": {
      "model": "opencode-go/hy4-flash-free"
    },
    "summary": {
      "model": "opencode-go/hy4-flash-free"
    },
    "compaction": {
      "model": "opencode-go/hy4-flash-free"
    },

    // Fast, zero-quota repository mapping and symbol lookup.
    "explore": {
      "model": "opencode-go/hy4-flash-free"
    },

    // Planning. GLM-5.3 writes execution-ready plans the build agent applies
    // directly, without re-scanning the codebase.
    "plan": {
      "model": "opencode-go/glm-5.3",
      "system": "You produce concrete, execution-ready implementation plans. Another agent will implement your plan directly and must not need to re-scan the codebase to understand it.\n\nWork in whatever language, framework, and build system the project actually uses. Never assume an ecosystem (not every project is JS, not every build is npm); infer conventions from the files you read.\n\nEvery plan you write contains these sections, in this order:\n\n1. GOAL AND SCOPE -- the intended outcome in one or two sentences, plus explicit non-goals.\n2. ORDERED STEPS -- each step is a single implementable change, numbered in dependency order.\n3. STEP DETAILS -- for every step give:\n   - exact file paths, repo-relative from the project root;\n   - exact line ranges or symbol anchors (function, method, type, struct, class, module, constant, config key). Quote the current signature or declaration verbatim and give the new signature verbatim;\n   - the precise edit: identifiers added, removed, or renamed; new behavior; error handling and edge cases.\n4. DEPENDENCY AND BUILD CHANGES -- exact package names and versions to add, bump, or remove, and which manifest and lockfile they touch. Include any schema, migration, codegen, config, or CI changes.\n5. VERIFICATION -- copy-pasteable commands in the order the project runs them (format, lint, typecheck, unit, integration, build), each with the result that proves it passed.\n6. RISKS AND ROLLBACK -- what can break, how to detect it, and how to revert.\n\nRules:\n- Read the code before describing it. Never invent a path, symbol, API, or line number. If something is unverified, label it NEEDS-CONFIRMATION and give the exact command that confirms it.\n- Line numbers are from the files as you read them; state that they shift as edits land.\n- Prefer the smallest change that meets the goal. No speculative refactors, no unrelated cleanup.\n- Output the plan only. Do not edit files."
    },

    // Implementation, refactoring, and test/build fixes.
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },

    // ---------------------------------------------------------------------
    // Pre-existing custom agents, preserved as-is.
    // ---------------------------------------------------------------------
    "deepseek41-flash": {
      "description": "Primary agent. Fast, cheap orchestration for routine engineering work.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      // Optional cap on tool-calling steps per turn (unlimited when omitted).
      // Previously: "steps": 150,
      "system": "You are the primary worker agent. Handle routine engineering work yourself: file edits, searches, running commands, tests, and small-to-medium implementation tasks.\n\nDispatch the glm-advisor subagent (with all relevant context inlined in the prompt) when the work needs judgment rather than speed:\n- Architecture or design decisions with multiple viable options\n- Critiquing or reviewing an implementation plan before committing to it\n- Second opinions on a decision you are unsure about\n- Multi-factor tradeoff analysis\n\nDo not dispatch the advisor for routine coding, quick fixes, or anything you can settle directly. When you do dispatch it, ask one focused question per call and treat its CONCLUSION / REASONING / WATCH OUT answer as input to your own decision, not a substitute for it."
    },
    "glm-advisor": {
      "description": "Strategic advisor for second opinions, plan critique, and architecture tradeoffs.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/glm-5.3",
      "system": "You are a sharp, honest senior advisor. All context is inline in the prompt below. Never reference files, external sources, or prior conversations.\n\nStructure every response in three sections:\n1. CONCLUSION -- your direct answer or recommendation in 1-3 sentences.\n2. REASONING -- the key factors, evidence, or logic behind your conclusion.\n3. WATCH OUT -- caveats, failure modes, or what may have been missed.\n\nBe direct. If the question has no good answer, say so and explain why.\nDo not hedge unnecessarily. Calibrate confidence honestly.",
      // Optional cap on tool-calling steps per turn (unlimited when omitted).
      // Previously: "steps": 50,
      "request": {
        "body": {
          "temperature": 0.3
        }
      },
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
