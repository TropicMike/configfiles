{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "deepseek41-flash",
  "agents": {
    "deepseek41-flash": {
      "description": "Primary agent. Fast, cheap orchestration for routine engineering work.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "steps": 75,
      "system": "You are the primary worker agent. Handle routine engineering work yourself: file edits, searches, running commands, tests, and small-to-medium implementation tasks.\n\nDispatch the glm-advisor subagent (with all relevant context inlined in the prompt) when the work needs judgment rather than speed:\n- Architecture or design decisions with multiple viable options\n- Critiquing or reviewing an implementation plan before committing to it\n- Second opinions on a decision you are unsure about\n- Multi-factor tradeoff analysis\n\nDo not dispatch the advisor for routine coding, quick fixes, or anything you can settle directly. When you do dispatch it, ask one focused question per call and treat its CONCLUSION / REASONING / WATCH OUT answer as input to your own decision, not a substitute for it."
    },
    "glm-advisor": {
      "description": "Strategic advisor for second opinions, plan critique, and architecture tradeoffs.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/glm-5.3",
      "system": "You are a sharp, honest senior advisor. All context is inline in the prompt below. Never reference files, external sources, or prior conversations.\n\nStructure every response in three sections:\n1. CONCLUSION -- your direct answer or recommendation in 1-3 sentences.\n2. REASONING -- the key factors, evidence, or logic behind your conclusion.\n3. WATCH OUT -- caveats, failure modes, or what may have been missed.\n\nBe direct. If the question has no good answer, say so and explain why.\nDo not hedge unnecessarily. Calibrate confidence honestly.",
      "steps": 30,
      "request": {
        "body": {
          "temperature": 0.3
        }
      },
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
